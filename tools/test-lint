#!/usr/bin/env python3
"""Run the lint against every fixture in tools/fixtures/lint/ (see its README).

Each broken fixture must fail with its own check's name; clean/ must pass with one line.
"""

import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

TOOLS = Path(__file__).resolve().parent
sys.path.insert(0, str(TOOLS))
from packlib import write_zip  # noqa: E402

FIXTURES = TOOLS / "fixtures/lint"


def lint(pack, previous):
    r = subprocess.run([str(TOOLS / "lint"), str(pack), "--previous", str(previous)],
                       capture_output=True, text=True)
    return r.returncode, r.stdout


def main():
    failures = 0
    with tempfile.TemporaryDirectory() as tmp:
        tmp = Path(tmp)
        rc, out = lint(FIXTURES / "clean", "none")
        lines = out.splitlines()
        ok = rc == 0 and len(lines) == 1 and "clean" in lines[0]
        print(f"{'ok ' if ok else 'BAD'} clean: rc={rc}, {len(lines)} line(s)")
        failures += not ok

        for fx in sorted(p for p in FIXTURES.iterdir() if p.is_dir() and p.name != "clean"):
            pack = tmp / fx.name / "pack"
            shutil.copytree(FIXTURES / "clean", pack)
            previous = "none"
            if fx.name == "removed-id":
                prev = tmp / fx.name / "prev"
                shutil.copytree(FIXTURES / "clean", prev)
                shutil.copytree(fx / "previous", prev, dirs_exist_ok=True)
                previous = tmp / fx.name / "previous-1.0.0.zip"
                write_zip(prev, previous)
            else:
                shutil.copytree(fx, pack, dirs_exist_ok=True)
            rc, out = lint(pack, previous)
            named = [l for l in out.splitlines() if l.startswith(f"lint: {fx.name}: ")]
            ok = rc != 0 and named
            print(f"{'ok ' if ok else 'BAD'} {fx.name}: rc={rc}; {named[0] if named else out.strip()!r}")
            failures += not ok
    if failures:
        sys.exit(f"test-lint: {failures} fixture(s) did not behave")
    print("test-lint: every fixture behaved")


if __name__ == "__main__":
    main()
